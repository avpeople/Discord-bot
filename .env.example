# --- Discord ---
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: register commands to a single guild instantly instead of globally (~1hr propagation)
DISCORD_GUILD_ID=

# Only members with this role may use /code
ALLOWED_ROLE_ID=

# --- GitHub ---
# Fine-grained PAT or GitHub App installation token, scoped to the repos the bot may touch
GITHUB_TOKEN=
# Used for git commit author on Claude's commits
GITHUB_COMMIT_NAME=Claude Code Bot
GITHUB_COMMIT_EMAIL=claude-bot@users.noreply.github.com

# --- Claude Code ---
# With subscription (OAuth) login, leave ANTHROPIC_API_KEY unset and instead run
# `claude login` once inside the running container (see README). CLAUDE_CONFIG_DIR
# points Claude Code at a persisted volume so the login survives restarts.
CLAUDE_CONFIG_DIR=/data/claude-config
# Optional fallback: if set, Claude Code uses API billing instead of subscription login
# ANTHROPIC_API_KEY=

# --- Storage ---
# Where repos get cloned/checked out on the container's persistent volume
WORKSPACE_DIR=/data/workspaces

# --- Voice bridge (optional) ---
# Only needed if you're running the bridge-discord service from the Coms
# server repo (Discord voice <-> LiveKit channel bridging via /voice).
# Leave both unset to disable /voice entirely.
# BRIDGE_DISCORD_URL=http://bridge-discord:8788
# BRIDGE_DISCORD_API_KEY=

# --- Inbound notify endpoint (optional) ---
# Lets external services (e.g. the Sports GFX site) POST a studio-monitoring
# log line to Discord via /studio set-log-channel's configured channel.
# Leave NOTIFY_API_KEY unset to disable this endpoint entirely (no port opened).
# NOTIFY_API_KEY=a-long-random-string
# NOTIFY_PORT=8790
